# Distribution for CommonsLang_Python (Darwin_arm64)

## CPython runtime (whole tree captured as SDK.Zip)

  $ run-function CommonsBase_Std.Extract.F_TarToZip@0.3.0 -f ${RUNTIME}/ignored.zip modver=CommonsLang_Python.SDK.Zip@3.13.14 tarmodver=CommonsLang_Python.SDK.Bundle@3.13.14 tarassetpath=cpython-3.13.14+20260728-aarch64-apple-darwin-install_only.tar.gz
  \test(pass)
  \dk.object(abi: "Release.Darwin_arm64", value-id: "ofiy3hgt3kkaqt7cvjztccypbwo6zlozhwh4pwbqngks2o3dilvgq")\;

## Python runner scriptmodule

  $ run-function CommonsLang_Python.SDK.Export@3.13.14 -f ${RUNTIME}/SDK.Export.zip
  \test(pass)
  \dk.object(abi: "Release.Darwin_arm64", value-id: "op2qkwnzw332b3ucnmhqdwlv4hjrccefjo5iy7rj2s5pl7diw3uhq")\;

## uv

  $ run-function CommonsLang_Python.Uv.Files@0.12.1 -d ${RUNTIME}/uv slot=Release.Darwin_arm64
  \test(pass)
  \dk.object(abi: "Release.Darwin_arm64", value-id: "oft5lw7eotoru4yvzfsrody3vxmke5ownuyx75ofbwtgz4zb6vqxq")\;

<!-- The `\dk.object(abi:..., value-id:...)` lines are recorded by dk0 at the
     first distribute build. -->

## UvLock (author-time lock generator scriptmodule)

  $ run-function CommonsLang_Python.UvLock.Export@1.0.0 -f ${RUNTIME}/UvLock.Export.zip
  \test(pass)
  \dk.object(abi: "Release.Darwin_arm64", value-id: "oeh3qipc2oxtzboc4q7roqhle5puq3w7pfavjl2b26ezrlbki5veq")\;

## UvBuild (build-time locked-package builder scriptmodule)

  $ run-function CommonsLang_Python.UvBuild.Export@1.0.0 -f ${RUNTIME}/UvBuild.Export.zip
  \test(pass)
  \dk.object(abi: "Release.Darwin_arm64", value-id: "omz2zpgybep5f6m7xcpoftfzdqenuzyphtgqts5mteg2cvfjtytzq")\;
