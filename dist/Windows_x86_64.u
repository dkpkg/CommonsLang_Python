# Distribution for CommonsLang_Python (Windows_x86_64)

## CPython runtime (whole tree captured as SDK.Zip)

  $ run-function CommonsBase_Std.Extract.F_TarToZip@0.3.0 -f ${RUNTIME}/ignored.zip modver=CommonsLang_Python.SDK.Zip@3.13.14 tarmodver=CommonsLang_Python.SDK.Bundle@3.13.14 tarassetpath=cpython-3.13.14+20260728-x86_64-pc-windows-msvc-install_only.tar.gz
  \test(pass)
  \dk.object(abi: "Release.Windows_x86_64", value-id: "ohypg47kid3y7ryd5nrhvkicy7ex4dpv2roibvljafiptnjogsyfa")\;

## Python runner scriptmodule

  $ run-function CommonsLang_Python.SDK.Export@3.13.14 -f ${RUNTIME}/SDK.Export.zip
  \test(pass)
  \dk.object(abi: "Release.Windows_x86_64", value-id: "ofaoraw5hciavg7xhag4curmt642hks6wtizg3uyihn54z777ouea")\;

## uv

  $ run-function CommonsLang_Python.Uv.Files@0.12.1 -d ${RUNTIME}/uv slot=Release.Windows_x86_64
  \test(pass)
  \dk.object(abi: "Release.Windows_x86_64", value-id: "oqene42kaeloyvxvtb6fwmd7frj27rx24hw45q6q25ausc2ub6zxa")\;

<!-- The `\dk.object(abi:..., value-id:...)` lines are recorded by dk0 at the
     first distribute build. -->

## UvLock (author-time lock generator scriptmodule)

  $ run-function CommonsLang_Python.UvLock.Export@1.0.0 -f ${RUNTIME}/UvLock.Export.zip
  \test(pass)
  \dk.object(abi: "Release.Windows_x86_64", value-id: "owpalfpw2f7fnmb3u7w4fex57yqlr6uaz6pwh6m4hxxv3f6aleasa")\;

