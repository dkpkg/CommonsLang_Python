# Distribution for CommonsLang_Python (Linux_x86_64)

## CPython runtime (whole tree captured as SDK.Zip)

  $ run-function CommonsBase_Std.Extract.F_TarToZip@0.3.0 -f ${RUNTIME}/ignored.zip modver=CommonsLang_Python.SDK.Zip@3.13.14 tarmodver=CommonsLang_Python.SDK.Bundle@3.13.14 tarassetpath=cpython-3.13.14+20260728-x86_64-unknown-linux-gnu-install_only.tar.gz
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "ozolaloti5yceys3izhu2jdsdu2hn2jdlg3f7u6wycmp3fduamcca")\;

## Python runner scriptmodule

  $ run-function CommonsLang_Python.SDK.Export@3.13.14 -f ${RUNTIME}/SDK.Export.zip
  \test(pass)
  \dk.object(abi: "Release.Linux_x86_64", value-id: "onxon3qciaatynuccbo26yuria7iuhzrt5uulob3mppbiut7xafmq")\;

## uv

  $ run-function CommonsLang_Python.Uv.Files@0.12.1 -d ${RUNTIME}/uv slot=Release.Linux_x86_64
  \test(pass)
